# Database Configuration
# Le backend tourne sur l'hôte (./mvnw spring-boot:run) et se connecte aux conteneurs
# docker-compose via localhost. Si 5432/6379 sont déjà pris sur ta machine, définis
# DB_HOST_PORT/REDIS_HOST_PORT (ports hôte utilisés par docker-compose) et aligne
# DB_PORT/REDIS_PORT dessus.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=loyalty_db
DB_USER=loyalty_user
DB_PASSWORD=loyalty_pass
# DB_HOST_PORT=5433

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# REDIS_HOST_PORT=6380

# Kafka Configuration
KAFKA_BROKERS=localhost:9092

# JWT Security — validation des jetons émis par Kernel Core.
# Les défauts d'application.yml pointent déjà sur le bon issuer ("kernel-core") et le
# JWKS https://kernel-core.yowyob.com/.well-known/jwks.json ; ne définir JWT_ISSUER_URI/
# JWT_JWK_SET_URI que pour cibler une autre instance Kernel Core.

# Application Server
SERVER_PORT=8081


# Kernel Core Configuration — ClientApplication dédié "loyality-program"
# (X-Client-Id/X-Api-Key envoyés par le backend ; la vraie clé API va dans .env, jamais ici)
KERNEL_CORE_URL=https://kernel-core.yowyob.com
KERNEL_SERVICE_CLIENT_ID=loyality-program
KERNEL_SERVICE_CLIENT_SECRET=changeme
# Laisser vide : Kernel Core ne supporte pas client_credentials (KernelCoreTokenService
# reste inactif tant que cette variable est vide — comportement voulu).
KERNEL_TOKEN_ENDPOINT=
# Tenant plateforme KernelCore sous lequel /api/v1/auth/login se connecte (X-Tenant-Id)
KERNEL_TENANT_ID=11111111-1111-1111-1111-111111111111
# Organisation KernelCore cible de l'inscription publique (POST /api/v1/auth/register).
# Tant qu'elle est vide, AuthService.register refuse toute inscription avec
# "Inscription indisponible : organisation cible non configurée". Doit aussi etre
# posee dans le docker-compose.prod.yml du deploiement, sinon la prod reste bloquee.
# application.yml a un defaut fonctionnel (ORG-AUTOCOLEEXCE-1111, la seule organisation
# existante aujourd'hui) : ne definir cette variable que pour cibler une autre organisation.
# Pour connaitre le code : se connecter via /api/v1/auth/login, la reponse porte
# le champ organizationCode.
KERNEL_ORGANIZATION_CODE=

# ── Passerelle de paiement KernelCore (payment-gateway-controller) ──────────────
# Tant que cette variable vaut false, PaymentGatewayStub sert les recharges : le
# parcours se deroule de bout en bout mais AUCUN encaissement reel n'a lieu.
KERNEL_PAYMENTS_ENABLED=false
# PlatformServiceCode facture pour l'encaissement. Le catalogue KernelCore ne contient
# pas de code LOYALTY ; ORGANIZATION est toujours effectif pour une organisation.
KERNEL_PAYMENTS_SERVICE_CODE=ORGANIZATION
# URL publique de ce backend rappelee par KernelCore en fin de paiement.
# Ex: https://loyalty.yowyob.com/api/v1/payments/callbacks/kernel-core
KERNEL_PAYMENTS_CALLBACK_URL=
# Secret partage attendu dans l'en-tete X-Payment-Callback-Key des callbacks entrants.
# Vide = route de callback fermee (401) : la confirmation ne passe alors que par
# POST /api/v1/members/{memberId}/wallet/top-ups/{reference}/confirm.
KERNEL_PAYMENTS_CALLBACK_SECRET=
# MYCOOLPAY (Mobile Money) ou STRIPE (carte).
KERNEL_PAYMENTS_DEFAULT_PROVIDER=MYCOOLPAY

# ── Console plateforme ────────────────────────────────────────────────────────
# Secret attendu dans l'en-tete X-Platform-Admin-Key sur /api/v1/admin/platform/**.
# Cette route n'est rattachee a aucun tenant : PlatformAdminAuthFilter est sa SEULE
# protection. Vide = route fermee (401) pour tout le monde, y compris la console.
PLATFORM_ADMIN_KEY=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Origines autorisees a emettre des requetes authentifiees (allowCredentials=true).
# Liste separee par des virgules. N'y mettre aucune origine http://localhost en prod :
# ce sont celles du profil dev uniquement (voir application-dev.yml).
CORS_ALLOWED_ORIGINS=https://loyalty.yowyob.com,https://dashboard.yowyob.com
